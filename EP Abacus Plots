library(dplyr)
library(ggplot2)
library(scales)


flounder.env<-read.csv("flounder_env.csv")
flounder.env <- flounder.env %>%
  mutate(Date = as.POSIXct(Date, tz = "UTC"))
flounder.env <- flounder.env %>%
  mutate(
    DRAINAGE_PLOT = case_when(
      toupper(DRAINAGE) == "PASCAGOULA" ~ "Pascagoula",
      toupper(DRAINAGE) %in% c("BACK BAY", "BILOXI") ~ "Back Bay",
      toupper(DRAINAGE) == "BSL" ~ "Bay Saint Louis",
      TRUE ~ NA_character_
    ),
    DRAINAGE_PLOT = factor(
      DRAINAGE_PLOT,
      levels = c("Pascagoula", "Back Bay", "Bay Saint Louis")
    )
  )
station.list <- sort(unique(flounder.env$RecGroup))

station.colors <- setNames(
  scales::hue_pal()(length(station.list)),
  station.list
)


make.abacus <- function(data, drainage.name) {

  plot.data <- data %>%
    filter(DRAINAGE_PLOT == drainage.name) %>%
    mutate(
      Full.ID = factor(
        Full.ID,
        levels = rev(sort(unique(Full.ID)))
      )
    )

  ggplot(
    plot.data,
    aes(
      x = Date,
      y = Full.ID,
      color = RecGroup
    )
  ) +
    geom_point(
      shape = 124,
      size = 3,
      stroke = 1
    ) +
    scale_color_manual(
      values = station.colors,
      drop = FALSE
    ) +
    scale_x_datetime(
      date_breaks = "1 month",
      date_labels = "%b\n%Y"
    ) +
    labs(
      title = drainage.name,
      x = "Detection Date",
      y = "Full ID",
      color = "Location"
    ) +
    theme_bw() +
    theme(
      #legend.position = "none",
      axis.text.y = element_text(size = 7),
      axis.text.x = element_text(size = 9),
      plot.title = element_text(face = "bold"),
      panel.grid.minor = element_blank()
    )
}


pascagoula.plot <- make.abacus(
  flounder.env, "Pascagoula"
)

backbay.plot <- make.abacus(
  flounder.env, "Back Bay"
)

bsl.plot <- make.abacus(
  flounder.env, "Bay Saint Louis"
)

pascagoula.plot
backbay.plot
bsl.plot


library(cowplot)
library(ggplot2)

legend.plot <- ggplot(
  flounder.env,
  aes(
    x = DateTime,
    y = Full.ID,
    color = Station
  )
) +
  geom_point(
    shape = 124,
    size = 3,
    stroke = 1
  ) +
  scale_color_manual(
    values = station.colors,
    name = "Telemetry Station"
  ) +
  theme_void() +
  theme(
    legend.position = "right",
    legend.title = element_text(
      size = 12,
      face = "bold"
    ),
    legend.text = element_text(size = 10)
  )

station.legend <- get_legend(legend.plot)
plot_grid(station.legend)


